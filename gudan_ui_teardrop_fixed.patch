+// 节点环绕火焰：水滴状火舌沿圆周切向排列，形成流动火环，不做太阳式放射尖刺。
+function flameRingUrl(outerStops, coreStops) {
+    // 单枚火舌是圆润水滴形。尖端沿圆周切向，根部朝向节点，避免向外放射的太阳轮廓。
+    const drop = `M20 1 C18.8 4.7 14.6 8 14.6 11.8 C14.6 15.1 17 17.1 20 17.3 C23 17.1 25.4 15.1 25.4 11.8 C25.4 8 21.2 4.7 20 1 Z`;
+    const core = `M20 6.2 C19.2 8.7 17.2 10.5 17.2 12.4 C17.2 14.1 18.4 15.2 20 15.2 C21.6 15.2 22.8 14.1 22.8 12.4 C22.8 10.5 20.8 8.7 20 6.2 Z`;
+    const angles = [-90, -30, 30, 90, 150, 210];
+    const scales = [1, 0.94, 1.04, 0.96, 1.02, 0.93];
+    const drops = angles.map((angle, i) => {
+        const rad = angle * Math.PI / 180;
+        const x = (20 + 11.5 * Math.cos(rad)).toFixed(2);
+        const y = (20 + 11.5 * Math.sin(rad)).toFixed(2);
+        // 每枚水滴沿圆周切向倾斜，火舌彼此衔接，形成包裹节点的火环。
+        return `<g transform="translate(${x} ${y}) rotate(${angle + 180}) scale(${scales[i]}) translate(-20 -9)">` +
+            `<path fill="url(#dropOuter)" d="${drop}"/><path fill="url(#dropCore)" d="${core}"/></g>`;
+    }).join("");
+    const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40"><defs>` +
+        `<linearGradient id="dropOuter" x1="0" y1="1" x2="0" y2="0">${outerStops}</linearGradient>` +
+        `<linearGradient id="dropCore" x1="0" y1="1" x2="0" y2="0">${coreStops}</linearGradient>` +
+        `</defs>${drops}</svg>`;
+    return `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
+}
